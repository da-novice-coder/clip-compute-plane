# Cloudflare R2 (required)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clip-renders
# Public r2.dev / custom domain base. If unset, 7-day presigned URLs are returned.
R2_PUBLIC_BASE_URL=

# Transcripts: ordered fallback chain of supadata, ytdlp, native
TRANSCRIPT_PROVIDER=supadata,ytdlp
SUPADATA_API_KEY=

# YouTube access for yt-dlp / FFmpeg (comma-separated http://user:pass@host:port)
PROXY_LIST=
# off (default) | legacy | modern
UA_MODE=off
# Optional: contents of a Netscape cookies.txt
YOUTUBE_COOKIES=

# Rendering: local (default) or rendi (hosted FFmpeg)
RENDER_BACKEND=local
RENDI_API_KEY=
RENDI_TIMEOUT=240

# Tuning
FFMPEG_THREADS=2
RENDER_CONCURRENCY=1
MAX_CLIP_SECONDS=180

# Reserved for when authentication is re-enabled
INTERNAL_SERVICE_TOKEN=
